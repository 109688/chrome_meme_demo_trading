{
  "manifest_version": 3,
  "name": "GMGN Paper Trade",
  "version": "1.7.6",
  "description": "GMGN paper trade — page DOM + WS realtime mark, Dex fallback only",
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://www.gmgn.ai/*",
        "https://gmgn.gracematrix.net/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://www.gmgn.ai/*",
        "https://gmgn.gracematrix.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://gmgn.ai/*",
    "https://www.gmgn.ai/*",
    "https://gmgn.gracematrix.net/*",
    "https://api.dexscreener.com/*"
  ]
}
